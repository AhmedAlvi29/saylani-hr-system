# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank or use mongodb://localhost:27017/saylani_hcm_lite)
# If local MongoDB is not running, the server automatically starts embedded MongoDB
MONGODB_URI=mongodb://localhost:27017/saylani_hcm_lite

# JWT Secret
JWT_SECRET=your_jwt_secret_change_in_production

# Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
# Optional: if left blank, an intelligent offline heuristic assistant answers live from the database
GEMINI_API_KEY=
