# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (leave blank or use mongodb://localhost:27017/hcm_lite)
# If left blank or unreachable, in-memory MongoDB will automatically start for zero-config judging
MONGODB_URI=mongodb://localhost:27017/saylani_hcm_lite

# JWT Secret Key
JWT_SECRET=your_jwt_secret_change_in_production

# Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/)
# If not provided, a resilient offline heuristic assistant responds with accurate role-scoped answers
GEMINI_API_KEY=

# Optional First-Run Admin Seed credentials (can also be entered via UI First-Run Wizard)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@saylani.org
ADMIN_PASSWORD=Admin@123456
